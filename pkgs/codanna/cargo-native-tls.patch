diff --git a/Cargo.toml b/Cargo.toml
index 72e8804..106c0b5 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -72,13 +72,13 @@ walkdir = "2.5.0"
 # no OpenSSL in the graph. On Linux the prebuilt ONNX Runtime binaries need
 # glibc 2.38+ and libstdc++ from GCC 13+.
 fastembed = { version = "=7.1.1", default-features = false, features = [
-    "hf-hub-rustls-tls",
-    "ort-download-binaries-rustls-tls",
+    "hf-hub-native-tls",
+    "ort-download-binaries-native-tls",
 ] }
 # The same crate instance as fastembed's own ort dependency: the two pins move
 # together, or the build links two ONNX runtimes. Used to commit the capped
 # global thread pool before fastembed creates its sessions.
-ort = { version = "=2.0.0-rc.13", default-features = false }
+ort = { version = "=2.0.0-rc.13", default-features = false, features = [ "pkg-config" ] }
 rand = "0.10.2"
 indicatif = "0.18.6"
 comfy-table = "7.2.2"
@@ -105,7 +105,7 @@ tree-sitter-lua = "0.5.0"
 tree-sitter-clojure-orchard = "0.2.8"
 glob = "0.3.4"
 async-trait = "0.1.92"
-reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
+reqwest = { version = "0.12", default-features = false, features = ["json", "native-tls"] }
 sysinfo = "0.39.6"
 indexmap = { version = "2.14.0", features = ["serde"] }
 
